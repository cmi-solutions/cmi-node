{
  "name": "cmi-node",
  "version": "1.0.0",
  "description": "Framework-agnostic CMI Payment Gateway SDK with built-in security for Node.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "require": {
        "types": "./dist/adapters/express.d.cts",
        "default": "./dist/adapters/express.cjs"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/adapters/nextjs.d.ts",
        "default": "./dist/adapters/nextjs.js"
      },
      "require": {
        "types": "./dist/adapters/nextjs.d.cts",
        "default": "./dist/adapters/nextjs.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "require": {
        "types": "./dist/adapters/fastify.d.cts",
        "default": "./dist/adapters/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      },
      "require": {
        "types": "./dist/adapters/hono.d.cts",
        "default": "./dist/adapters/hono.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/adapters/nestjs.d.ts",
        "default": "./dist/adapters/nestjs.js"
      },
      "require": {
        "types": "./dist/adapters/nestjs.d.cts",
        "default": "./dist/adapters/nestjs.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run type-check && npm run test && npm run build",
    "test": "tsx --test test/accountType.test.ts test/gateway.test.ts test/php-parity.test.ts",
    "test:coverage": "c8 tsx --test test/**/*.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "husky"
  },
  "keywords": [
    "payment",
    "gateway",
    "cmi",
    "morocco",
    "payment-processing",
    "express",
    "nextjs",
    "nestjs",
    "nodejs",
    "typescript",
    "framework-agnostic",
    "secure-payments",
    "3d-secure"
  ],
  "author": "Ishak Zail <ishak.zail.iz@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/integrationcmi/cmi.git"
  },
  "bugs": {
    "url": "https://github.com/integrationcmi/cmi/issues"
  },
  "homepage": "https://github.com/integrationcmi/cmi#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^20.19.24",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "c8": "^9.1.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "express": ">=4.0.0",
    "fastify": ">=4.0.0",
    "hono": ">=3.0.0",
    "next": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
