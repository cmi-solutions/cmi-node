{
  "name": "cmi-node",
  "version": "2.0.0",
  "description": "Framework-agnostic CMI Payment Gateway SDK with built-in security for Node.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "express": [
        "./dist/adapters/express.d.ts"
      ],
      "nextjs": [
        "./dist/adapters/nextjs.d.ts"
      ],
      "fastify": [
        "./dist/adapters/fastify.d.ts"
      ],
      "hono": [
        "./dist/adapters/hono.d.ts"
      ],
      "nestjs": [
        "./dist/adapters/nestjs.d.ts"
      ]
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "worker": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "workerd": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "worker": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "require": {
        "types": "./dist/adapters/express.d.cts",
        "default": "./dist/adapters/express.cjs"
      }
    },
    "./nextjs": {
      "workerd": {
        "types": "./dist/adapters/nextjs.d.ts",
        "default": "./dist/adapters/nextjs.js"
      },
      "worker": {
        "types": "./dist/adapters/nextjs.d.ts",
        "default": "./dist/adapters/nextjs.js"
      },
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/adapters/nextjs.d.ts",
        "default": "./dist/adapters/nextjs.js"
      },
      "require": {
        "types": "./dist/adapters/nextjs.d.cts",
        "default": "./dist/adapters/nextjs.cjs"
      }
    },
    "./fastify": {
      "workerd": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "worker": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "require": {
        "types": "./dist/adapters/fastify.d.cts",
        "default": "./dist/adapters/fastify.cjs"
      }
    },
    "./hono": {
      "workerd": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      },
      "worker": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      },
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      },
      "require": {
        "types": "./dist/adapters/hono.d.cts",
        "default": "./dist/adapters/hono.cjs"
      }
    },
    "./nestjs": {
      "workerd": {
        "types": "./dist/adapters/nestjs.d.ts",
        "default": "./dist/adapters/nestjs.js"
      },
      "worker": {
        "types": "./dist/adapters/nestjs.d.ts",
        "default": "./dist/adapters/nestjs.js"
      },
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/adapters/nestjs.d.ts",
        "default": "./dist/adapters/nestjs.js"
      },
      "require": {
        "types": "./dist/adapters/nestjs.d.cts",
        "default": "./dist/adapters/nestjs.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run type-check && npm run test && npm run build",
    "test": "tsx --test test/accountType.test.ts test/gateway.test.ts test/php-parity.test.ts test/review-fixes.test.ts test/secret-leakage.test.ts test/pre-release.test.ts test/adapters.integration.test.ts",
    "test:coverage": "c8 --check-coverage --lines 92 --branches 86 tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "husky || exit 0",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "keywords": [
    "payment",
    "gateway",
    "cmi",
    "morocco",
    "payment-processing",
    "express",
    "nextjs",
    "nestjs",
    "nodejs",
    "typescript",
    "framework-agnostic",
    "secure-payments",
    "3d-secure"
  ],
  "author": "Ishak Zail <ishak.zail.iz@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmi-solutions/cmi-node.git"
  },
  "bugs": {
    "url": "https://github.com/cmi-solutions/cmi-node/issues"
  },
  "homepage": "https://github.com/cmi-solutions/cmi-node#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "hono": "^4.13.18",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "express": "^4.17.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
