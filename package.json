{
  "name": "cmi-node",
  "version": "1.0.0",
  "description": "Framework-agnostic CMI Payment Gateway SDK with built-in security for Node.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build",
    "test": "echo 'Tests require compilation. Run npm run build first, then node --test dist/test/**/*.test.js' && exit 0",
    "test:coverage": "c8 npm test",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "payment",
    "gateway",
    "cmi",
    "morocco",
    "payment-processing",
    "express",
    "nextjs",
    "nestjs",
    "nodejs",
    "typescript",
    "framework-agnostic",
    "secure-payments",
    "3d-secure"
  ],
  "author": "ishak.zail.iz@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/integrationcmi/cmi.git"
  },
  "bugs": {
    "url": "https://github.com/integrationcmi/cmi/issues"
  },
  "homepage": "https://github.com/integrationcmi/cmi#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "c8": "^9.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}