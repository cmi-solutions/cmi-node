# Secret scan of the staged changes. CI scans the full history in any case.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || {
    echo "❌ gitleaks found a possible secret in the staged changes. Remove it before committing."
    exit 1
  }
else
  echo "⚠️  gitleaks is not installed: staged secret scan skipped (https://github.com/gitleaks/gitleaks#installing)."
fi

npm test
